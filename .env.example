# Printer's local IP (Screen > Settings > Network)
BAMBU_HOST=192.168.1.50
# Serial number (Screen > Settings > Device)
BAMBU_SERIAL=01P00A000000000
# LAN access code (Screen > Settings > Network > Access code)
BAMBU_ACCESS_CODE=12345678

# Overlay server (optional)
# BAMBU2OBS_HOST=127.0.0.1   # 0.0.0.0 if OBS runs on another PC
# BAMBU2OBS_PORT=8765
